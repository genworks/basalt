# Install Basalt as systemd units on this machine.
#
#   cd /path/to/basalt && sh systemd/install
#
# Installs FOUR units, all generated from the templates beside this
# script by substituting the invoking user and this clone's path:
#
#   basalt.service           the stack; restarts on failure
#   basalt.timer             starts the stack 20s AFTER boot completes
#   basalt-watchdog.service  recovery for a wedged console or stack
#   basalt-watchdog.timer    runs the watchdog every 5 minutes
#
# The units carry this yard's name (basalt.*, 2026-09-10), so a Basalt
# can be installed beside an upstream Basilisk on the same host: the
# two installers never touch each other's units.
#
# The stack is started by basalt.timer, NOT by WantedBy=multi-user.target.
# A Type=oneshot unit in the boot target makes systemd wait for the whole
# container stack before declaring boot done -- 10.128s of a 12.078s boot on
# one WSL host, past WSL's 10000ms WaitForBootProcess limit, so every boot
# logged "/sbin/init failed to start within 10000ms".  See basalt.timer.
#
# ONE UNIT, NOT ONE PER HOST.  Until 2026-08-15 every *-stack repo shipped
# its own near-identical copy of the service file, and the whole difference
# between all five was the image variant plus a description string.  Host
# specifics now arrive as DATA: each stack's ./install writes
# systemd/host.env into this clone, and the unit reads it.  Nothing about a
# particular box belongs in these templates.
#
# Also retires the legacy skewed-emacs.service, which pointed at a
# compose-dev that no longer exists in the skewed-emacs repo.
#
# Overrides:  BASILISK_USER=  BASILISK_DIR=  SYSTEMD_DIR=

set -eu

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BASILISK_DIR="${BASILISK_DIR:-$(cd "${SCRIPT_DIR}/.." && pwd)}"
BASILISK_USER="${BASILISK_USER:-$(logname 2>/dev/null || echo "${USER:-$(id -un)}")}"
SYSTEMD_DIR="${SYSTEMD_DIR:-/etc/systemd/system}"
LEGACY="skewed-emacs.service"

echo "=== Basalt systemd install ==="
echo "  User         : ${BASILISK_USER}"
echo "  Basalt dir   : ${BASILISK_DIR}"
echo "  Unit dir     : ${SYSTEMD_DIR}"
echo ""

# ---- preflight --------------------------------------------------------------

[ -x "${BASILISK_DIR}/basalt" ] || {
    echo "ERROR: no executable ${BASILISK_DIR}/basalt"
    echo "       Basalt runs from a clone of its own repo; see README.md."
    exit 1
}
id "${BASILISK_USER}" >/dev/null 2>&1 || { echo "ERROR: no such user ${BASILISK_USER}"; exit 1; }
groups "${BASILISK_USER}" 2>/dev/null | grep -qw docker || {
    echo "WARNING: ${BASILISK_USER} is not in the docker group."
    echo "         Add with: sudo usermod -aG docker ${BASILISK_USER}"
}
[ -x "${SCRIPT_DIR}/watchdog" ] || chmod +x "${SCRIPT_DIR}/watchdog" 2>/dev/null || true

# ---- install units ----------------------------------------------------------

for unit in basalt.service basalt.timer basalt-watchdog.service basalt-watchdog.timer; do
    [ -f "${SCRIPT_DIR}/${unit}" ] || { echo "ERROR: missing template ${unit}"; exit 1; }
    sed -e "s|%%USER%%|${BASILISK_USER}|g" \
        -e "s|%%BASILISK_DIR%%|${BASILISK_DIR}|g" \
        "${SCRIPT_DIR}/${unit}" \
      | sudo tee "${SYSTEMD_DIR}/${unit}" > /dev/null
    echo "Wrote ${SYSTEMD_DIR}/${unit}"
done

if [ -f "${BASILISK_DIR}/systemd/host.env" ]; then
    echo ""
    echo "Host injection in effect (${BASILISK_DIR}/systemd/host.env):"
    sed 's/^/    /' "${BASILISK_DIR}/systemd/host.env"
else
    echo ""
    echo "No systemd/host.env in this clone -- the stack will start on image"
    echo "defaults.  A host stack's ./install writes one; run it if this box"
    echo "should pin an image variant."
fi

# ---- retire the legacy unit -------------------------------------------------

if [ -f "${SYSTEMD_DIR}/${LEGACY}" ]; then
    echo ""
    echo "Retiring legacy ${LEGACY} (it points at a compose-dev that no"
    echo "longer exists in the skewed-emacs repo)."
    sudo systemctl disable --now "${LEGACY}" >/dev/null 2>&1 || true
    sudo mv "${SYSTEMD_DIR}/${LEGACY}" "${SYSTEMD_DIR}/${LEGACY}.retired-$(date +%Y%m%d)"
    echo "  moved aside to ${LEGACY}.retired-$(date +%Y%m%d)"
fi

# ---- enable -----------------------------------------------------------------

sudo systemctl daemon-reload

# Migration for boxes installed before 2026-08-16, when the stack was pulled
# in by multi-user.target directly.  Disabling only moves the .wants symlink;
# it does not stop a running stack, and it is a no-op on a fresh box.
if systemctl is-enabled basalt.service >/dev/null 2>&1; then
    echo "Taking basalt.service off the boot critical path (now timer-started)."
    sudo systemctl disable basalt.service >/dev/null 2>&1 || true
fi

sudo systemctl enable basalt.timer >/dev/null
sudo systemctl enable basalt-watchdog.timer >/dev/null
echo ""
echo "Enabled basalt.timer (starts the stack 20s after boot) and"
echo "basalt-watchdog.timer.  basalt.service is installed but not"
echo "boot-enabled -- the timer starts it, so boot is not blocked on Docker."
echo ""
echo "Start now with:      sudo systemctl start basalt"
echo "Watch recovery with: journalctl -u basalt-watchdog -f"
echo "Check the watchdog:  ${BASILISK_DIR}/systemd/watchdog --dry-run"
