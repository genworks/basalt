# MCP exec wrapper - starts compose stack on demand if needed,
# then execs into the container to run the MCP wrapper.
#
# CRITICAL: This script must not output ANYTHING to stdout except
# the MCP protocol messages from the final exec. Any stray output
# will corrupt the MCP stdio protocol and cause the client to fail.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
COMPOSE_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
# THE INSTANCE THIS LAUNCHER SERVES (2026-10-19).  compose-dev gives
# every instance its own compose project -- the clone's directory name,
# plus -<instance> -- so a launcher that asked bare `docker compose'
# found no ready room for a named instance (BASILISK_INSTANCE=alpha),
# took the ship for down, and raised a NEW one beside it.  The instance
# is BASILISK_INSTANCE from the environment (set but empty means the
# bare one), else the instance .env was last generated for.  The port
# offset and the galaxy are carried the same way, so a raise this
# launcher starts reproduces the standing instance rather than a bare
# one at offset 0.
_env_value() { sed -n "s/^$1=//p" "${COMPOSE_DIR}/.env" 2>/dev/null | head -1; }
[ -n "${BASILISK_INSTANCE+set}" ] || BASILISK_INSTANCE="$(_env_value BASILISK_INSTANCE)"
[ -n "${BASILISK_PORT_OFFSET:-}" ] || BASILISK_PORT_OFFSET="$(_env_value BASILISK_PORT_OFFSET)"
[ -n "${PROJECTS_DIR:-}" ] || PROJECTS_DIR="$(_env_value PROJECTS_DIR)"
export BASILISK_INSTANCE
[ -n "$BASILISK_PORT_OFFSET" ] && export BASILISK_PORT_OFFSET
[ -n "$PROJECTS_DIR" ] && export PROJECTS_DIR
COMPOSE_PROJECT="$(basename "$COMPOSE_DIR" | tr 'A-Z' 'a-z')${BASILISK_INSTANCE:+-$BASILISK_INSTANCE}"
# The Captain's ROOM, not his name: every backend is reached by
# exec'ing the MCP wrapper inside the ready room, whatever backend
# --backend-host then names.  Container names are minted per muster
# now (rooms are known by their keepers), so the stable address is
# the compose SERVICE -- the room's type slug -- and compose exec
# resolves it to whoever keeps the room this tour.  Overridable for
# the same reasons eskew is.  (Was `captain` before the third relief,
# 2026-08-23 -- the stale default made every MCP server time out.)
# The crew ledger is the source of truth for the room's slug -- a
# fork's console service may carry its own hostname, and
# BASILISK_POST_CAPTAIN_ROOM in generated/crew.env says which.  Env
# override outranks the ledger; the class slug is the last fallback.
_ledger_room="$(sed -n 's/^BASILISK_POST_CAPTAIN_ROOM=//p' "${COMPOSE_DIR}/generated/crew.env" 2>/dev/null | head -1)"
SERVICE_NAME="${BASILISK_CAPTAIN:-${_ledger_room:-ready-room}}"
# One lock, one starter mark and one log PER YARD (2026-09-10).  Two
# stacks on one host (this yard and a fork of it) each raise their
# own compose project, but every launcher used to share
# /tmp/mcp-exec.lock: with both stacks down and a client launching
# all servers at once, the second yard's launchers waited out the
# first yard's raise on its lock, gave up on the lock, then waited
# 90 s for a service nobody was raising, and failed.  The key is the
# yard's resolved path, so two clones never share a lock and a moved
# clone gets a fresh one.
_yard_key="$(cd "$COMPOSE_DIR" && pwd -P | cksum | cut -d' ' -f1)"
_yard_key="$(basename "$(cd "$COMPOSE_DIR" && pwd -P)")-${_yard_key}${BASILISK_INSTANCE:+-$BASILISK_INSTANCE}"
LOG_FILE="/tmp/mcp-exec-${_yard_key}.log"
LOCK_DIR="/tmp/mcp-exec-${_yard_key}.lock"
LOCK_PID_FILE="${LOCK_DIR}/pid"
STARTER_FILE="/tmp/mcp-compose-starter-${_yard_key}"
MAX_WAIT_SECONDS=90

# Track if this instance started compose and holds the lock
I_STARTED_COMPOSE=false
I_HOLD_LOCK=false

# All logging goes to file and stderr, NEVER stdout
log() {
    echo "[$(date -Iseconds)] [$$] $1" >> "$LOG_FILE"
    echo "[$(date -Iseconds)] [$$] $1" >&2
}

# Run docker compose commands in the compose directory, against this
# instance's compose project (see THE INSTANCE THIS LAUNCHER SERVES).
compose() {
    (cd "$COMPOSE_DIR" && docker compose -p "$COMPOSE_PROJECT" "$@")
}

# Check if service is running using docker compose
is_service_running() {
    local status
    status=$(compose ps --format '{{.State}}' "$SERVICE_NAME" 2>/dev/null)
    [ "$status" = "running" ]
}

# Get health status using docker compose
get_health_status() {
    compose ps --format '{{.Health}}' "$SERVICE_NAME" 2>/dev/null
}

# Check if a lock is stale (owner process no longer exists)
is_lock_stale() {
    if [ -f "$LOCK_PID_FILE" ]; then
        local lock_pid
        lock_pid=$(cat "$LOCK_PID_FILE" 2>/dev/null)
        if [ -n "$lock_pid" ] && ! kill -0 "$lock_pid" 2>/dev/null; then
            return 0
        fi
    fi
    return 1
}

# Acquire lock with timeout - prevents multiple instances from racing
acquire_lock() {
    local waited=0
    
    if [ -d "$LOCK_DIR" ] && is_lock_stale; then
        log "Removing stale lock (owner process no longer exists)"
        rm -rf "$LOCK_DIR"
    fi
    
    while ! mkdir "$LOCK_DIR" 2>/dev/null; do
        if is_lock_stale; then
            log "Removing stale lock during wait"
            rm -rf "$LOCK_DIR"
            continue
        fi
        
        if [ $waited -ge 30 ]; then
            log "WARNING: Timeout waiting for lock, proceeding anyway"
            return 1
        fi
        sleep 1
        waited=$((waited + 1))
        if [ $((waited % 5)) -eq 0 ]; then
            log "Waiting for lock... ($waited/30)"
        fi
    done
    
    echo $$ > "$LOCK_PID_FILE"
    I_HOLD_LOCK=true
    return 0
}

release_lock() {
    if [ "$I_HOLD_LOCK" = true ]; then
        rm -rf "$LOCK_DIR"
        I_HOLD_LOCK=false
        log "Lock released"
    fi
}

# Wait for service to be healthy using docker compose
wait_for_healthy() {
    local waited=0

    log "Waiting for service ${SERVICE_NAME} to be healthy..."

    while true; do
        local health_status
        health_status=$(get_health_status)

        case "$health_status" in
            healthy)
                log "Service ${SERVICE_NAME} is healthy"
                return 0
                ;;
            unhealthy)
                log "WARNING: Service ${SERVICE_NAME} is unhealthy, proceeding anyway..."
                return 1
                ;;
            starting|"")
                ;;
            *)
                log "Unknown health status: ${health_status}"
                ;;
        esac

        if [ $waited -ge $MAX_WAIT_SECONDS ]; then
            log "WARNING: Timeout waiting for ${SERVICE_NAME} to be healthy (status: ${health_status}), proceeding anyway..."
            return 1
        fi

        sleep 1
        waited=$((waited + 1))

        if [ $((waited % 5)) -eq 0 ]; then
            log "Still waiting for ${SERVICE_NAME} to be healthy... ($waited/$MAX_WAIT_SECONDS, status: ${health_status})"
        fi
    done
}

# Cleanup function - called when MCP wrapper exits (Claude Desktop quit)
cleanup_on_exit() {
    local exit_code=$?
    
    # Release lock if we still hold it
    release_lock
    
    # Check if we're the instance that started compose
    if [ "$I_STARTED_COMPOSE" = true ] && [ -f "$STARTER_FILE" ]; then
        local starter_pid
        starter_pid=$(cat "$STARTER_FILE" 2>/dev/null)
        if [ "$starter_pid" = "$$" ]; then
            log "Claude Desktop quit - we started compose, shutting it down..."
            # Through compose-dev, not bare compose: a bare `docker
            # compose down` reads docker-compose.yml alone, so overlay
            # rooms (transporter room, guild workshops) would be left
            # standing; compose-dev assembles every .yml, takes the
            # slipway lock, and sweeps orphans.
            (cd "$COMPOSE_DIR" && ./compose-dev down) >> "$LOG_FILE" 2>&1
            rm -f "$STARTER_FILE"
            log "Compose shutdown complete"
        fi
    fi
    
    exit $exit_code
}

log "mcp-exec starting with args: $@"

# Check if service is running
if ! is_service_running; then
    log "Service ${SERVICE_NAME} is not running, need to start composition..."

    if acquire_lock; then
        log "Lock acquired, checking again if service is running..."

        if ! is_service_running; then
            log "Service still not running, starting the composition..."

            # Clean up any stale containers first -- via compose-dev so
            # overlay rooms come down too (bare compose sees only the
            # base file) and the slipway lock serializes against any
            # concurrent raise.
            (cd "$COMPOSE_DIR" && ./compose-dev down) >> "$LOG_FILE" 2>&1 || true

            # Start compose stack using compose-dev wrapper
            (cd "$COMPOSE_DIR" && ./compose-dev up --daemon) >> "$LOG_FILE" 2>&1

            compose_exit=$?

            if [ $compose_exit -ne 0 ]; then
                log "ERROR: compose-dev up failed with exit code $compose_exit"
                release_lock
                exit 1
            fi

            # Mark ourselves as the starter
            echo $$ > "$STARTER_FILE"
            I_STARTED_COMPOSE=true
            log "Compose started successfully (we are the starter: PID $$)"
        else
            log "Service was started by another instance while waiting for lock"
        fi
    else
        log "Could not acquire lock, assuming another instance is handling startup"
    fi

    log "Waiting for service to appear..."

    waited=0
    while ! is_service_running; do
        if [ $waited -ge $MAX_WAIT_SECONDS ]; then
            log "ERROR: Timeout waiting for service ${SERVICE_NAME} to start"
            release_lock
            exit 1
        fi
        sleep 1
        waited=$((waited + 1))
        if [ $((waited % 5)) -eq 0 ]; then
            log "Waiting for service... ($waited/$MAX_WAIT_SECONDS)"
        fi
    done

    # NOW release lock - service is confirmed running
    release_lock

    log "Service is running, waiting for health check to pass..."
    wait_for_healthy
    log "Service ${SERVICE_NAME} is ready"
fi

# The lisply doors' shared secret (2026-10-19).  When the galaxy holds
# .secrets/lisply-secret, every wrapper sends it as X-Lisply-Secret,
# reading the file inside the ready room (again whenever it changes), so
# the secret never sits on a command line or in the client's config.
# Gendl rooms are told the same file (GENDL_LISPLY_SECRET_FILE, emitted
# by generate-configs.el at up).  Passed only when the room's wrapper
# knows the option: an older wrapper refuses an unknown flag and the
# server would die at launch.
_projects_dir="${PROJECTS_DIR:-$(cd "${COMPOSE_DIR}/.." && pwd)}"
if [ -s "${_projects_dir}/.secrets/lisply-secret" ]; then
    if compose exec -T "${SERVICE_NAME}" grep -q -- '--admin-secret-file' \
         /home/emacs-user/lisply-mcp/scripts/mcp-wrapper.js </dev/null >/dev/null 2>&1; then
        set -- "$@" --admin-secret-file /projects/.secrets/lisply-secret --admin-secret-header X-Lisply-Secret
        log "lisply secret: the wrapper reads /projects/.secrets/lisply-secret"
    else
        log "lisply secret present, but this console's wrapper predates --admin-secret-file: not passed"
    fi
fi

log "Executing MCP wrapper in service container..."

# Set up cleanup trap - fires when the supervise loop exits (Claude Desktop quit)
trap cleanup_on_exit EXIT

# Supervise loop (2026-07-26): a container restart (e.g. autoheal after a
# wedged backend) kills the exec'd wrapper process.  Previously that ended
# this script, leaving the MCP client with a permanently dead server (the
# client never respawns servers).  Now we respawn the wrapper once the
# container is back, so MCP sessions survive container bounces with no
# human intervention.  Notes:
#  - fd 0 (the MCP stdio pipe from the client) persists across respawns;
#    requests written while no wrapper is running buffer in the pipe and
#    are processed by the next wrapper.  Only requests in flight at the
#    moment of death are lost (those single calls time out client-side).
#  - Wrapper exit 0 = clean shutdown (client closed stdin) -> we exit too.
#  - Nonzero exit -> wait for container running + healthy, then respawn.
#  - Fast-exit breaker: 20 consecutive sub-60s lifetimes -> give up, so a
#    permanently broken backend cannot spin forever.

CONSECUTIVE_FAST_EXITS=0

while true; do
    WRAPPER_START=$(date +%s)
    compose exec -T "${SERVICE_NAME}" node /home/emacs-user/lisply-mcp/scripts/mcp-wrapper.js "$@"
    WRAPPER_EXIT=$?
    WRAPPER_ELAPSED=$(( $(date +%s) - WRAPPER_START ))

    if [ "$WRAPPER_EXIT" -eq 0 ]; then
        log "Wrapper exited cleanly (status 0, ${WRAPPER_ELAPSED}s) - shutting down"
        exit 0
    fi

    log "Wrapper exited status=${WRAPPER_EXIT} after ${WRAPPER_ELAPSED}s - container likely restarted"

    if [ "$WRAPPER_ELAPSED" -ge 60 ]; then
        CONSECUTIVE_FAST_EXITS=0
    else
        CONSECUTIVE_FAST_EXITS=$((CONSECUTIVE_FAST_EXITS + 1))
        if [ "$CONSECUTIVE_FAST_EXITS" -ge 20 ]; then
            log "ERROR: ${CONSECUTIVE_FAST_EXITS} consecutive fast wrapper exits - giving up"
            exit 1
        fi
    fi

    # Wait for the service to come back (autoheal wedge-to-healthy is
    # about 2 minutes; be generous)
    waited=0
    while ! is_service_running; do
        if [ "$waited" -ge 180 ]; then
            log "ERROR: service ${SERVICE_NAME} did not return within 180s - giving up"
            exit 1
        fi
        sleep 2
        waited=$((waited + 2))
        if [ $((waited % 10)) -eq 0 ]; then
            log "Waiting for ${SERVICE_NAME} to return... (${waited}/180)"
        fi
    done

    wait_for_healthy
    log "Respawning MCP wrapper into recovered ${SERVICE_NAME}"
    sleep 1
done
