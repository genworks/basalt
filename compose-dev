connect_emacs() {
    log_info "Connecting to Emacs via emacsclient (the ready room)"
    _ce_cap="$(room_container ready-room)"
    if [ -n "$_ce_cap" ]; then
        docker exec -it "$_ce_cap" emacsclient -t
    else
        log_error "no keeper found for the ready room -- is the ship up?"
        return 1
    fi
