# Random 1-based pick from a space-separated word list ($1).  No bash
# arrays/$RANDOM (dash has neither) -- /dev/urandom via od, same
# portability posture as the rest of this script.
_crew_pick() {
    set -- $1
    _cp_n=$#
    _cp_r=$(od -An -N2 -tu2 /dev/urandom | tr -d ' ')
    _cp_i=$(( (_cp_r % _cp_n) + 1 ))
    eval "echo \${$_cp_i}"
}

# One species-flavored name, unique against every name minted so far
# THIS RUN (_crew_minted_names).  20 collisions -> numeral-disambiguated
# (mirrors eyes-only-metrics.lisp's MINT-CREW-NAME).
_crew_unique_name() {
    _cun_species="$1"
    _cun_tries=0
    while :; do
        _cun_name="$(_crew_pick "$(_crew_onsets_for "$_cun_species")")$(_crew_pick "$(_crew_finals_for "$_cun_species")")"
        case " ${_crew_minted_names} " in
            *" ${_cun_name} "*)
                _cun_tries=$((_cun_tries + 1))
                [ $_cun_tries -ge 20 ] && {
                    _cun_name="${_cun_name}-$(od -An -N1 -tu1 /dev/urandom | tr -d ' ')"
                    break
                }
                continue
                ;;
            *) break ;;
        esac
    done
    # set a result var, NOT echo+$(...) -- a command-substitution call
    # would run this function in a SUBSHELL, silently discarding its
    # write to _crew_minted_names (caught empirically 2026-08-14: two
    # calls minted the same name back to back).  Callers read
    # $_crew_unique_name_result after calling this directly.
    _crew_minted_names="${_crew_minted_names:+$_crew_minted_names }${_cun_name}"
    _crew_unique_name_result="$_cun_name"
}

# =============================================================================
# THE MUSTER (ruling 2026-08-23): ROOMS ARE KNOWN BY THEIR KEEPERS.
#
# container_name is the PRIMARY RESIDENT'S minted personal name --
# docker's native name field carries the crew name, nothing invented --
# while the service key / hostname / in-network DNS stay the room's
# module slug (the type-hail).  The generated compose interpolates
#     container_name: ${BASILISK_PREFIX:-}${BASILISK_CREW_<MODULE>:-<module>}
# so these vars must be exported before ANY invocation that could
# create a container.  muster_crew mints them (species-flavored pools
# above) and persists the roll in .muster (per instance, uncommitted,
# beside .ship); muster_load re-exports a standing roll for every other
# command, so a recreate during e.g. `restart' validation does not
# quietly rename anyone.
#
# RELIEF SEMANTICS: a name is kept while a container bearing it exists.
# No container (first raise, after a down, after a docker rm) -> a
# fresh name is minted: the relief in place, fresh face, fresh name,
# same room.  A kill+recreate during validation keeps the name (the
# wedged hand is revived, not relieved); whether an image change should
# force a relief is deliberately left simple for now -- the name
# follows the container's existence, nothing subtler.
# =============================================================================
_muster_file() {
    printf '%s/.muster%s' "$SCRIPT_DIR" "${BASILISK_INSTANCE:+-$BASILISK_INSTANCE}"
}

muster_load() {
    _ml_f="$(_muster_file)"
    [ -f "$_ml_f" ] || return 0
    while IFS='=' read -r _ml_k _ml_v; do
        case "$_ml_k" in
            BASILISK_CREW_*) export "$_ml_k=$_ml_v" ;;
        esac
    done < "$_ml_f"
}

muster_crew() {
    _mc_ledger=$(mktemp) || return 0
    _mc_found=0
    for _mc_e in "${SCRIPT_DIR}/generated/crew.env" "${SCRIPT_DIR}/generated/"*-crew.env; do
        [ -f "$_mc_e" ] || continue
        cat "$_mc_e" >> "$_mc_ledger"
        _mc_found=1
    done
    if [ "$_mc_found" = 0 ]; then
        log_warning "no crew ledger in generated/; the vat raises unmustered rooms (module-slug container names)"
        rm -f "$_mc_ledger"
        return 0
    fi

    _mc_muster="$(_muster_file)"
    _mc_out=$(mktemp) || { rm -f "$_mc_ledger"; return 0; }
    _mc_existing="$(docker ps -a --format '{{.Names}}' 2>/dev/null)"
    _crew_minted_names=""

    # Module rows out of the layered ledgers, last file winning key-wise
    # (same layering substitute_templates uses).  Each row: NAME<TAB>SPECIES.
    _mc_rows=$(awk -F= '
        /^BASILISK_MOD_[A-Z0-9_]*_NAME=/    { k=$1; sub(/_NAME$/,"",k);    name[k]=$2 }
        /^BASILISK_MOD_[A-Z0-9_]*_SPECIES=/ { k=$1; sub(/_SPECIES$/,"",k); spec[k]=$2 }
        END { for (k in name) print name[k] "\t" spec[k] }' "$_mc_ledger" | sort)
    rm -f "$_mc_ledger"

    log_info "Mustering the crew (rooms are known by their keepers):"
    while IFS='	' read -r _mc_room _mc_species; do
        [ -n "$_mc_room" ] || continue
        # The ledger species carries provenance (gornskew/gendl:devo-ccl);
        # the name pools key on bare repo:tag, so strip the home planet
        # the same way identity minting does.
        _mc_species="$(_crew_species_from_image "$_mc_species")"
        _mc_var="BASILISK_CREW_$(printf '%s' "$_mc_room" | tr 'a-z' 'A-Z' | tr -c 'A-Z0-9\n' '_')"
        _mc_cur=""
        [ -f "$_mc_muster" ] && \
            _mc_cur="$(sed -n "s/^${_mc_var}=//p" "$_mc_muster" | head -1)"
        if [ -n "$_mc_cur" ] && printf '%s\n' "$_mc_existing" | \
            grep -qxF "${BASILISK_PREFIX:-}${_mc_cur}"; then
            # The hand is aboard: same name, same room, watch continues.
            _crew_minted_names="${_crew_minted_names:+$_crew_minted_names }${_mc_cur}"
            _mc_name="$_mc_cur"
            log_info "  ${_mc_name}'s $(printf '%s' "$_mc_room" | tr '-' ' ') stands its watch"
        else
            # No container bearing the name: mint a relief.  Unique per
            # run via _crew_minted_names, against every name the docker
            # daemon already knows -- and never the very name being
            # relieved: a relief is a fresh face, and a re-rolled
            # "Anaune relieves Anaune" reads as a hand surviving the
            # ship (drawn live from the 64-name autoheal pool,
            # 2026-08-24).
            _mc_tries=0
            while :; do
                _crew_unique_name "$_mc_species"
                _mc_name="$_crew_unique_name_result"
                if [ "$_mc_name" != "$_mc_cur" ] && \
                   ! printf '%s\n' "$_mc_existing" | \
                       grep -qxF "${BASILISK_PREFIX:-}${_mc_name}"; then
                    break
                fi
                _mc_tries=$((_mc_tries + 1))
                [ "$_mc_tries" -ge 20 ] && break
            done
            if [ -n "$_mc_cur" ]; then
                log_info "  ${_mc_name} relieves ${_mc_cur} in the $(printf '%s' "$_mc_room" | tr '-' ' ')"
            else
                log_info "  ${_mc_name} musters into the $(printf '%s' "$_mc_room" | tr '-' ' ')"
            fi
        fi
        printf '%s=%s\n' "$_mc_var" "$_mc_name" >> "$_mc_out"
        export "$_mc_var=$_mc_name"
    done << _MC_ROWS
$_mc_rows
_MC_ROWS

    mv "$_mc_out" "$_mc_muster"
}

mint_crew_identities() {
    _ci_tmp=$(mktemp)
    _ci_ids="$(run_compose ps -q 2>"$_ci_tmp")"
    if [ -z "$_ci_ids" ]; then
        [ -s "$_ci_tmp" ] && log_warning "compose ps -q (minting) came back empty: $(head -1 "$_ci_tmp")"
        _ci_net="$(ship_network)"
        _ci_ids="$(docker ps -q ${_ci_net:+-f "network=${_ci_net}"} 2>/dev/null)"
        [ -n "$_ci_ids" ] && log_info "  (crew found by network lookup instead)"
    fi
    rm -f "$_ci_tmp"
    [ -n "$_ci_ids" ] || return 0

    _ci_ship="$(_ship_name)"
    for _ci_id in $_ci_ids; do
        _ci_name="$(docker inspect --format "{{.Name}}" "$_ci_id" 2>/dev/null)" || continue
        _ci_name="${_ci_name#/}"

        if docker exec "$_ci_name" test -f /tmp/skewed-crew-identity 2>/dev/null; then
            continue   # already identified -- filesystem survived, keep the name
        fi

_ci_image="$(docker inspect --format \
            "{{.Config.Image}}" \
            "$_ci_id" 2>/dev/null)"

        # Posting is the container's hostname, which the generator set
        # from the SSoT :name.  Fall back to the container name with any
        # BASILISK_PREFIX stripped, for containers created before this.
        _ci_posting="$(docker inspect --format "{{.Config.Hostname}}" \
            "$_ci_id" 2>/dev/null)"
        [ -n "$_ci_posting" ] || _ci_posting="${_ci_name#${BASILISK_PREFIX:-}}"

        # Species is the image type, full stop -- no label to consult,
        # no post default to fall back to, nothing to resolve between
        # (Dave, 2026-08-17).  The old three-step chain also had an
        # ordering bug that dies with it: its post-default arm ran
        # against the HOSTNAME-derived posting, because the
        # basilisk.post label override below had not happened yet.
        _ci_species="$(_crew_species_from_image "$_ci_image")"

        # Post: the declared label wins, the hostname is the
        # fallback for containers created before labels existed.
        _ci_post="$(docker inspect \
            --format '{{index .Config.Labels "basilisk.post"}}' \
            "$_ci_id" 2>/dev/null)"
        [ -n "$_ci_post" ] && _ci_posting="$_ci_post"

        _ci_role="$(_crew_role_for_postings "$_ci_posting")"
        # The container name IS the minted name now (ruling 2026-08-23:
        # rooms are known by their keepers) -- the muster minted it
        # before the vat ran, so the identity file simply records it.
        # No second minting here: one hand, one name.
        _ci_mint_name="${_ci_name#${BASILISK_PREFIX:-}}"

        # NAME= stays FIRST: every reader is key-based except
        # skewed-emacs's dashboard, which reads line 1 and requires the
        # NAME= prefix.  MANNED= used to be appended last and is no
        # longer written at all -- see the note where its table was;
        # every reader scans for its own keys, so dropping it is
        # backward-compatible the same way adding it was.
        if docker exec "$_ci_name" sh -c \
            "printf 'NAME=%s\nSPECIES=%s\nPOSTING=%s\nROLE=%s\n' '$_ci_mint_name' '$_ci_species' '$_ci_posting' '$_ci_role' > /tmp/skewed-crew-identity" \
            2>/dev/null
        then
            log_success "  $(_crew_display "$_ci_name") (module sku ${_ci_species}) takes the Oath of Service${_ci_ship:+ to the R.V. ${_ci_ship}}"
        else
            log_warning "  ${_ci_name}: could not write crew identity (no shell/writable rootfs?)"
        fi
    done
}


# =============================================================================
# MCP CONFIG MERGE
#
# Writes merged MCP config files inside the skewed-emacs container and
# updates /home/emacs-user/.codex/config.toml and ~/.grok/config.toml.
# Runs AFTER validate_services: overlay copies into a container that
# validation might still kill+recreate would be lost, and a validated
# skewed-emacs (its lisply-ping healthcheck is served by the emacs
# daemon itself) proves the daemon is ready -- the merge runs exactly
# once, event-driven, replacing the old 5x2s blind retry loop.
# =============================================================================
merge_mcp_configs() {
    log_info "Opening hailing frequencies for cyborg passengers (MCP configurations, JSON + TOML)..."

    # Resolve the ready room's keeper ONCE and drive everything below
    # through plain docker on the container id: compose-level service
    # resolution failed intermittently mid-raise (2026-08-23, cause
    # under observation via room_container's logging), and each of the
    # seven compose-addressed steps below then failed in its own way.
    _mcp_cap="$(room_container ready-room)"
    if [ -z "$_mcp_cap" ]; then
        log_warning "no keeper found for the ready room; skipping MCP config merge"
        return 1
    fi

    case " ${VALIDATED_OK:-} " in
        *" ready-room "*) ;;
        *)
            # The ready room was not validated this run (single-service
            # up, failed validation, or already running from before):
            # probe the Captain's daemon once directly instead of
            # looping blind.
            if ! docker exec "$_mcp_cap" emacsclient --eval t \
                > /dev/null 2>&1
            then
                log_warning "Captain daemon not available; skipping MCP config merge"
                return 1
            fi
            ;;
    esac

    # Lite-variant images do not ship ~/.codex and ~/.grok, so docker
    # creates those file-mount parent dirs ROOT-OWNED at container
    # create time (a recreate reintroduces them; host-side chown cannot
    # reach container-fs dirs).  The merge writes config.toml into both,
    # so repair ownership first; harmless no-op on full images.
    docker exec -u root "$_mcp_cap" sh -c \
        "chown -R emacs-user /home/emacs-user/.codex /home/emacs-user/.grok" \
        > /dev/null 2>&1 || true

    # Step 1: Stage the YARD's mcp/ into the Captain.
    #
    # mcp/ left the skewed-emacs repo when it was spun off to basilisk,
    # so the image no longer carries /home/emacs-user/skewed-emacs/mcp
    # and neither the base configs nor merge-mcp-configs.el are aboard.
    # This used to copy overlays into that now-absent directory with
    # `|| true`, so every copy failed silently and the merge then died
    # on a missing load-file -- surfacing only as "daemon answered but
    # merge errored" (found on a real deploy, 2026-08-16).  The yard owns
    # these files now, so the yard hands them over at up-time.
    #
    # Same failure shape as the mcp/entrypoint.sh incident: a split moved
    # files by concept without checking every consumer.
    _mcp_stage="/tmp/basilisk-mcp"
    docker exec "$_mcp_cap" mkdir -p "$_mcp_stage" > /dev/null 2>&1 || {
        log_warning "could not create $_mcp_stage in the Captain; skipping MCP merge"
        return 1
    }

    for _mcpfile in \
        "${SCRIPT_DIR}/mcp/merge-mcp-configs.el" \
        "${SCRIPT_DIR}/mcp/mcp-container.json" \
        "${SCRIPT_DIR}/mcp/mcp-windows.json" \
        "${SCRIPT_DIR}/mcp/mcp.toml" \
        "${SCRIPT_DIR}/mcp/"*-mcp-windows.json \
        "${SCRIPT_DIR}/mcp/"*-mcp-container.json \
        "${SCRIPT_DIR}/mcp/"*-mcp.toml
    do
        [ -f "$_mcpfile" ] || continue
        [ -n "${BASILISK_VERBOSE:-}" ] && log_info "Staging: $(basename "$_mcpfile")"
        docker cp "$_mcpfile" "${_mcp_cap}:${_mcp_stage}/" > /dev/null 2>&1 \
            || log_warning "  could not stage $(basename "$_mcpfile")"
    done

    # Step 1b: Copy overlay services-generated Emacs files, PLUS
    # services-discovery.el -- the discovery/merge logic and the
    # generated files are a matched pair (sparse overlay entries rely
    # on key-wise merging in discovery).  Syncing one without the
    # other skews them when the running image predates a discovery
    # change (bit us 2026-08-09: gendl-ccl vanished from the dashboard
    # Swank list on a stale image + fresh sparse overlay).
    # Sources differ on purpose.  services-generated.el files are YARD
    # OUTPUT and live in generated/; services-discovery.el is Emacs
    # CONFIGURATION and stays in the Captain's dot-files tree.  That split
    # is the whole point of the basilisk move -- see MIGRATION.md.
    #
    # The glob is *services-generated.el, NOT *-services-generated.el, and
    # the missing dash is load-bearing.  It has to match the unprefixed
    # BASE file as well as the <host>-stack- prefixed overlays.  Until the
    # rip, the base file reached the container baked into the skewed-emacs
    # image, so only overlays needed copying; now that the yard has left
    # that repo the image no longer carries it, and a dashed glob would
    # silently ship a container that knows about cyclops and the GDL units
    # but not about skewed-emacs, gendl-sbcl or autoheal.
    for _overlay in "${SCRIPT_DIR}/generated/"*services-generated.el \
                    "${SCRIPT_DIR}/dot-files/emacs.d/etc/services-discovery.el"; do
        [ -f "$_overlay" ] || continue
        [ -n "${BASILISK_VERBOSE:-}" ] && log_info "Copying overlay: $(basename "$_overlay")"
        docker cp "$_overlay" \
            "${_mcp_cap}:/home/emacs-user/skewed-emacs/dot-files/emacs.d/etc/" > /dev/null 2>&1 || true
    done

    # Step 2: Merge inside container -- one shot; the daemon is ready.
    if docker exec "$_mcp_cap" emacsclient --eval \
        "(progn (setenv \"SKEWED_CLONE_PATH\" \"${SCRIPT_DIR}\")
                (load-file \"${_mcp_stage}/merge-mcp-configs.el\")
                (skewed-merge-all-mcp-configs \"${_mcp_stage}\"))" \
        > /dev/null 2>&1
    then
        log_success "Hailing frequencies posted for container CLI, Windows, Codex, and Grok"

        # Copy the platform-appropriate Claude Desktop config back to the
        # host clone (regression fix: the pre-POSIX compose-dev did this).
        # WSL hosts get the wsl-wrapped config; Linux/macOS get the native one.
        if grep -qi microsoft /proc/version 2>/dev/null; then
            _cdc_src="/tmp/merged-mcp-windows.json"
        else
            _cdc_src="/tmp/merged-mcp-host.json"
        fi
        # Claude CODE's registry is a different file from Claude
        # Desktop's, and cannot be copied over: ~/.claude.json carries
        # machineID, userID, seen-notification state and migration flags
        # alongside mcpServers.  So the yard also drops the host-form
        # config here, and mcp/install-claude-code-config splices just
        # its mcpServers key into ~/.claude.json.  Always the host form,
        # never the windows one -- Claude Code runs inside WSL, where
        # the wsl.exe wrapper the Desktop config needs would be wrong.
        docker cp "${_mcp_cap}:/tmp/merged-mcp-host.json" \
            "${SCRIPT_DIR}/mcp/claude-code-mcp.json" > /dev/null 2>&1 \
            || log_warning "could not stage mcp/claude-code-mcp.json"

        if docker cp "${_mcp_cap}:${_cdc_src}" \
            "${SCRIPT_DIR}/mcp/claude_desktop_config.json" > /dev/null 2>&1; then
            log_success "Claude Desktop config ready: mcp/claude_desktop_config.json (see docs/CLAUDE_DESKTOP.md)"
        else
            log_warning "Could not copy Claude Desktop config from container"
            log_warning "(an older skewed-emacs image may not generate ${_cdc_src};"
            log_warning " try './compose-dev up --pull' to fetch the latest image)"
        fi

        refresh_host_claude_mcp
    else
        log_warning "MCP configuration merge failed (daemon answered but merge errored)"
        log_warning "Retry with: ./compose-dev up"
        return 1
    fi
}

# =============================================================================
# STARTUP VALIDATION ("container started" != "service validated")
#
# CCL occasionally loses its ASLR dice roll at startup ("exception 11" /
# "bad frame in rt_sigreturn", upstream Clozure/ccl#85): the process
# does not exit -- it hangs in the CCL kernel debugger -- so
# `restart: unless-stopped` never fires and the container sits there
# "running" while never becoming healthy.  The generated healthchecks
# have long intervals (gendl-ccl: 72s x 3 retries), so docker/autoheal
# take minutes to notice; a gendl container that is going to come up
# does so well within ~30s.  So compose-dev owns start-time validation
# itself (autoheal keeps steady-state duty):
#
#   - Each healthchecked container is actively probed every few seconds
#     by running its own compose-declared healthcheck test via docker
#     exec -- no per-service knowledge is hardcoded here, and docker's
#     slow health interval stops mattering at startup.
#   - A container that exhausts its budget unvalidated is KILLED
#     (SIGKILL: the wedged CCL debugger is SIGTERM-immune) and
#     RECREATED -- a fresh exec re-rolls the ASLR dice; a hung-at-start
#     container holds no state worth preserving.
#   - Retries are capped; then we fail LOUDLY with a nonzero exit so a
#     systemd oneshot unit shows the failure.
#
# Tunables (env):
#   HEALTH_WAIT_SECS        per-service validation budget (default 30)
#   HEALTH_BUDGET_<name>    per-service override, name sanitized to
#                           [A-Za-z0-9_], e.g. HEALTH_BUDGET_gendl_ccl=45
#   HEALTH_MAX_RESTARTS     kill+recreate budget per service (default 2)
#   HEALTH_POLL_SECS        probe cadence (default 2)
#   VALIDATE_PROBE_TIMEOUT  in-container timeout per probe (default 5)
#
# Results are exported in VALIDATED_OK / VALIDATED_FAILED (space-
# separated container names) for later phases (e.g. the MCP merge).
# =============================================================================
_vs_sanitize() {
    printf '%s' "$1" | tr -c 'a-zA-Z0-9' '_'
}

# Run one active probe of a container: its own declared healthcheck
# test via docker exec, wrapped in an in-container timeout (probe
# lesson from the rt_sigreturn brief: put the timeout INSIDE the
# container).  Falls back to docker's health status when the container
# lacks timeout(1) or the test could not be extracted.
_vs_probe() {
    _vp_san="$(_vs_sanitize "$1")"
    eval "_vp_cmd=\${_vs_probe_cmd_${_vp_san}:-}"
    if [ -n "$_vp_cmd" ]; then
        docker exec "$1" sh -c \
            "timeout -s KILL ${VALIDATE_PROBE_TIMEOUT:-5} $_vp_cmd" \
            > /dev/null 2>&1
        _vp_rc=$?
        [ "$_vp_rc" -eq 0 ] && return 0
        if [ "$_vp_rc" -eq 127 ]; then
            # timeout(1) missing in this container: retry bare.
            docker exec "$1" sh -c "$_vp_cmd" > /dev/null 2>&1 && return 0
        fi
    fi
    [ "$(docker inspect --format \
        '{{if .State.Health}}{{.State.Health.Status}}{{else}}unknown{{end}}' \
        "$1" 2>/dev/null)" = "healthy" ]
}

# Kill + recreate one container.  SIGKILL, not SIGTERM: a wedged CCL
# sits in its kernel debugger, which ignores SIGTERM.  Recreate (not
# restart) also re-resolves mount sources and image config.
_vs_recreate() {
    docker kill "$1" > /dev/null 2>&1
    if ! run_compose up -d --force-recreate --no-deps "$2" > /dev/null 2>&1; then
        log_error "  ${1}: recreate failed (docker compose up --force-recreate ${2})"
    fi
}

# =============================================================================
# CREW MUSTER -- what the articles expect vs what is actually aboard
#
# Nothing ever CHECKED the ship's complement at runtime, so a ship could
# report every service healthy while serving nothing at all.  Sally did
# exactly that on 2026-08-15 -- validation passed, five containers
# green, and the ingress publishing a dev port instead of :80, which no
# layer mentioned because no layer was looking.
#
# So this prints the manifest every time: post, service, and the ports it
# actually publishes.  Making the ingress port visible at startup is most
# of the value; a wrong one is obvious the moment you can see it.
# =============================================================================
crew_muster() {
    _cm_services=$(run_compose config --services 2>/dev/null | tr -d '\r' | sort)
    [ -n "$_cm_services" ] || return 0

    log_info "Crew muster:"
    _cm_have_pilot=0
    for _cm_svc in $_cm_services; do
        # The container name is the keeper's minted name now, so resolve
        # it through compose (service -> container id -> name) rather
        # than assuming prefix+service.  A room with nobody aboard shows
        # under its bare type.
        _cm_cid="$(room_container "$_cm_svc")"
        if [ -n "$_cm_cid" ]; then
            _cm_cname="$(docker inspect --format '{{.Name}}' "$_cm_cid" 2>/dev/null)"
            _cm_cname="${_cm_cname#/}"
        else
            _cm_cname="${BASILISK_PREFIX:-}${_cm_svc}"
        fi
        # Titles come from the DECLARED posting label when there is
        # one (a comma list -- no posting primary), from the service
        # name for containers created before labels (a private
        # species->title copy here silently mustered every renamed
        # post as "Crew" on a real deploy, 2026-08-16 -- one table,
        # one truth).  Posting-derived directly since 2026-08-24, so
        # every posting on the books gets its own title (the Curator
        # used to muster as "Crew" through the ROLE bottleneck).  A
        # container with NO posting at all is a STOWAWAY: a species
        # specimen aboard, comprehended like anyone else, assigned
        # nothing.
        _cm_posts="$(docker inspect --format \
            '{{index .Config.Labels "basilisk.post"}}' \
            "$_cm_cname" 2>/dev/null)"
        if [ -n "$_cm_posts" ]; then
            _cm_post="$(_crew_title_for_postings "$_cm_posts")"
            [ -n "$_cm_post" ] || _cm_post="${BASILISK_VOCAB_TITLE_CREW:-Crew}"
            [ "$(_crew_role_for_postings "$_cm_posts")" = "pilot" ] && _cm_have_pilot=1
        else
            _cm_post="$(_crew_title_for_posting "$_cm_svc")"
            [ -n "$_cm_post" ] || _cm_post="${BASILISK_VOCAB_TITLE_STOWAWAY:-Stowaway}"
            [ "$(_crew_role_for_posting "$_cm_svc")" = "pilot" ] && _cm_have_pilot=1
        fi
        _cm_ports=$(docker ps --filter "name=^${_cm_cname}\$" \
                              --format '{{.Ports}}' 2>/dev/null \
                        | tr ',' '\n' | sed -n 's/.*0\.0\.0\.0:\([0-9]*\)->\([0-9]*\).*/\1->\2/p' \
                        | sort -u | tr '\n' ' ')
        # Rooms are known by their keepers: "Thweed's ready room".
        _cm_keeper="${_cm_cname#${BASILISK_PREFIX:-}}"
        _cm_room="$(printf '%s' "$_cm_svc" | tr '-' ' ')"
        if [ "$_cm_keeper" = "$_cm_svc" ]; then
            _cm_shown="$_cm_room (unkept)"
        else
            _cm_shown="${_cm_keeper}'s ${_cm_room}"
        fi
        printf '  %-8s %-30s %s\n' "$_cm_post" "$_cm_shown" "${_cm_ports:-(no published ports)}"

        # REQUIREMENTS vs CAPABILITIES (Dave, 2026-08-17).  A posting
        # states its requirements (basilisk.requires, emitted by the
        # yard); the species states its capabilities in its own image
        # manifest (basilisk.capabilities label) -- the SSoT for what an
        # image can do.  A manifest with no capability list cannot be
        # verified and says so quietly; a manifest that HAS one and is
        # missing a required capability is a loud warning.
        # One crew member may stand several posts (basilisk.post is a
        # comma list; no posting is primary).  Print the full list
        # whenever there is more than the name already says.
        case "$_cm_posts" in
            *,*) log_info "    stands: ${_cm_posts}" ;;
        esac
        # REQUIREMENTS vs CAPABILITIES: basilisk.requires unions the
        # qualifications of every post stood (emitted by the yard from
        # the :postings tables); basilisk.capabilities on the IMAGE
        # manifest is the SSoT for what the species can do.  A missing
        # capability WARNS and never errors -- the ability may come
        # aboard by arrangement (a services-init hook, at boot or
        # later), which the manifest cannot know.
        _cm_requires="$(docker inspect --format \
            '{{index .Config.Labels "basilisk.requires"}}' \
            "$_cm_cname" 2>/dev/null)"
        if [ -n "$_cm_requires" ]; then
            _cm_img="$(docker inspect --format '{{.Config.Image}}' \
                "$_cm_cname" 2>/dev/null)"
            _cm_caps="$(docker image inspect --format \
                '{{index .Config.Labels "basilisk.capabilities"}}' \
                "$_cm_img" 2>/dev/null)"
            if [ -z "$_cm_caps" ]; then
                log_info "    requires [${_cm_requires}]; species manifest carries no capability list (cannot verify)"
            else
                _cm_old_ifs=$IFS; IFS=','
                for _cm_req in $_cm_requires; do
                    case ",$_cm_caps," in
                        *",$_cm_req,"*) ;;
                        *) log_warning "    ${_cm_svc}: stands a post requiring \"${_cm_req}\" but species ${_cm_img} does not list it (arranged aboard?)" ;;
                    esac
                done
                IFS=$_cm_old_ifs
            fi
        fi
    done

    # An absent post is legal -- every post is optional, :captain included --
    # but it has a consequence worth saying out loud.
    if [ "$_cm_have_pilot" -eq 0 ]; then
        log_warning "${BASILISK_VOCAB_NO_INGRESS_WARNING:-no Transporter Chief aboard: nothing fronts HTTP; publish ports directly}"
        # Register-neutral machinery words only in this hint -- the
        # line above it speaks whatever register the vocabulary loads.
        log_warning "  (if one is intended here, the <host>-stack overlay is not installed:"
        log_warning "   run <host>-stack/install, which copies <host>-stack-compose.yml here)"
    fi
}

validate_services() {
    _vs_budget_default="${HEALTH_WAIT_SECS:-30}"
    _vs_retries_max="${HEALTH_MAX_RESTARTS:-2}"
    _vs_poll="${HEALTH_POLL_SECS:-2}"
    VALIDATED_OK=""
    VALIDATED_FAILED=""

    _vs_err_tmp=$(mktemp)
    _vs_ids="$(run_compose ps -q 2>"$_vs_err_tmp")"
    if [ -z "$_vs_ids" ]; then
        [ -s "$_vs_err_tmp" ] && log_warning "compose ps -q (validation) came back empty: $(head -1 "$_vs_err_tmp")"
        _vs_net="$(ship_network)"
        _vs_ids="$(docker ps -q ${_vs_net:+-f "network=${_vs_net}"} 2>/dev/null)"
    fi
    rm -f "$_vs_err_tmp"
    if [ -z "$_vs_ids" ]; then
        # A ship with no crew gets a LOUD flag either way: either the
        # crew catastrophically failed to board (the muster went
        # sideways -- read the compose output and journal above), or the
        # owner is deliberately floating an empty ship for reasons only
        # he would know.  Success is still reported -- an empty ship is
        # not a failed one -- but never silently.
        log_warning "=================================================================="
        log_warning "SHIP IS CREWLESS: compose reports NO running containers."
        log_warning "Either no one boarded (check the compose output and the journal"
        log_warning "above) or she is deliberately riding empty at anchor."
        log_warning "Nothing to validate; reporting success on an EMPTY ship."
        log_warning "=================================================================="
        return 0
    fi

    # Build the watch list: containers that declare a usable healthcheck.
    _vs_watched=""
    for _vs_id in $_vs_ids; do
        _vs_name="$(docker inspect --format '{{.Name}}' "$_vs_id" 2>/dev/null)" || continue
        _vs_name="${_vs_name#/}"
        _vs_test="$(docker inspect --format \
            '{{if .Config.Healthcheck}}{{join .Config.Healthcheck.Test " "}}{{end}}' \
            "$_vs_id" 2>/dev/null)"
        case "$_vs_test" in
            ""|NONE|"NONE "*)
                log_info "  $(_crew_display "$_vs_name"): started (no healthcheck; not validated)"
                continue
                ;;
        esac
        # An UNHURRIED hand does not hold the gangway (the museum
        # chamber's antique takes the better part of a minute to boot
        # and light the plate).  He is started and left to warm up in
        # the background; docker's own healthcheck still runs, the
        # Doctor revives a boot that goes dark, and `./basilisk status`
        # shows him healthy when the exhibit lights.  Without this,
        # every raise held ~44s for the docent -- long enough for an
        # anonymous visitor to conclude the ship is wedged.
        if [ "$(docker inspect --format \
                '{{index .Config.Labels "basilisk.unhurried"}}' \
                "$_vs_id" 2>/dev/null)" = "true" ]; then
            log_info "  $(_crew_display "$_vs_name"): warming up in the background (an unhurried hand; not gating the raise)"
            continue
        fi
        _vs_svc="$(docker inspect --format \
            '{{index .Config.Labels "com.docker.compose.service"}}' \
            "$_vs_id" 2>/dev/null)"
        [ -n "$_vs_svc" ] || _vs_svc="$_vs_name"
        _vs_san="$(_vs_sanitize "$_vs_name")"
        _vs_probe_tmp=""
        case "$_vs_test" in
            "CMD-SHELL "*) _vs_probe_tmp="${_vs_test#CMD-SHELL }" ;;
            "CMD "*)       _vs_probe_tmp="${_vs_test#CMD }" ;;
        esac
        eval "_vs_svc_${_vs_san}=\$_vs_svc"
        eval "_vs_probe_cmd_${_vs_san}=\$_vs_probe_tmp"
        # The keeper's display form ("Captain Thrilk in the Ready Room"),
        # computed once here so the watch loop below never shells out.
        _vs_disp="$(_crew_display "$_vs_name")"
        eval "_vs_disp_${_vs_san}=\$_vs_disp"
        # A hand whose healthcheck declares a start_period has stated
        # its own warm-up (the museum chamber's antique machine takes a
        # minute to boot and photograph itself); the budget honors it.
        # An env override still wins; the default remains the floor.
        # (StartPeriod renders as a Go duration ("2m0s"); .Seconds gives
        # a plain number.)
        _vs_sp_s="$(docker inspect --format \
            '{{if .Config.Healthcheck}}{{.Config.Healthcheck.StartPeriod.Seconds}}{{end}}' \
            "$_vs_id" 2>/dev/null)"
        _vs_sp_s="${_vs_sp_s%.*}"
        _vs_sp_budget="$_vs_budget_default"
        case "$_vs_sp_s" in
            ''|*[!0-9]*) : ;;
            *) [ "$_vs_sp_s" -gt "$_vs_sp_budget" ] && _vs_sp_budget="$_vs_sp_s" ;;
        esac
        eval "_vs_budget_${_vs_san}=\${HEALTH_BUDGET_${_vs_san}:-\$_vs_sp_budget}"
        eval "_vs_state_${_vs_san}=pending"
        eval "_vs_elapsed_${_vs_san}=0"
        eval "_vs_tries_${_vs_san}=0"
        _vs_watched="${_vs_watched:+$_vs_watched }$_vs_name"
    done
    [ -n "$_vs_watched" ] || return 0

    # One line states the watch for everyone; a hand is named here only
    # when his stated warm-up buys him more than the standard budget.
    log_info "The gangway watch: hailing each room every ${_vs_poll}s (${_vs_budget_default}s and ${_vs_retries_max} reliefs allowed apiece)"
    for _vs_name in $_vs_watched; do
        _vs_san="$(_vs_sanitize "$_vs_name")"
        eval "_vs_budget=\$_vs_budget_${_vs_san}"
        if [ "$_vs_budget" != "$_vs_budget_default" ]; then
            eval "_vs_disp=\$_vs_disp_${_vs_san}"
            log_info "  ${_vs_disp:-$_vs_name}: allowed ${_vs_budget}s (stated warm-up)"
        fi
    done

    _vs_total=0
    while :; do
        _vs_pending=0
        for _vs_name in $_vs_watched; do
            _vs_san="$(_vs_sanitize "$_vs_name")"
            eval "_vs_state=\$_vs_state_${_vs_san}"
            [ "$_vs_state" = "pending" ] || continue

            if _vs_probe "$_vs_name"; then
                eval "_vs_tries=\$_vs_tries_${_vs_san}"
                eval "_vs_disp=\$_vs_disp_${_vs_san}"
                if [ "$_vs_tries" -gt 0 ]; then
                    log_success "  ${_vs_disp:-$_vs_name}: validated at ${_vs_total}s (after ${_vs_tries} kill+recreate)"
                else
                    log_success "  ${_vs_disp:-$_vs_name}: validated at ${_vs_total}s"
                fi
                eval "_vs_state_${_vs_san}=ok"
                # VALIDATED_OK carries SERVICE names (the room slugs):
                # container names are minted per-muster now, so a later
                # phase checking for the ready-room must not have to
                # know who keeps it this tour.
                eval "_vs_okname=\$_vs_svc_${_vs_san}"
                VALIDATED_OK="${VALIDATED_OK:+$VALIDATED_OK }${_vs_okname:-$_vs_name}"
                continue
            fi

            eval "_vs_elapsed=\$_vs_elapsed_${_vs_san}"
            eval "_vs_budget=\$_vs_budget_${_vs_san}"
            if [ "$_vs_elapsed" -ge "$_vs_budget" ]; then
                eval "_vs_tries=\$_vs_tries_${_vs_san}"
                if [ "$_vs_tries" -lt "$_vs_retries_max" ]; then
                    _vs_tries=$((_vs_tries + 1))
                    eval "_vs_tries_${_vs_san}=\$_vs_tries"
                    eval "_vs_svc=\$_vs_svc_${_vs_san}"
                    log_warning "  ${_vs_name}: not validated after ${_vs_budget}s (hung start?) -- kill + recreate (${_vs_tries}/${_vs_retries_max})"
                    _vs_recreate "$_vs_name" "$_vs_svc"
                    eval "_vs_elapsed_${_vs_san}=0"
                else
                    log_error "  ${_vs_name}: FAILED: still not validated after ${_vs_retries_max} kill+recreate retries"
                    eval "_vs_state_${_vs_san}=failed"
                    VALIDATED_FAILED="${VALIDATED_FAILED:+$VALIDATED_FAILED }$_vs_name"
                    continue
                fi
            else
                eval "_vs_elapsed_${_vs_san}=$((_vs_elapsed + _vs_poll))"
            fi
            _vs_pending=1
        done

        [ "$_vs_pending" -eq 0 ] && break
        sleep "$_vs_poll"
        _vs_total=$((_vs_total + _vs_poll))
    done

    if [ -z "$VALIDATED_FAILED" ]; then
        log_success "All hands validated in ${_vs_total}s; the ship is away"
        crew_muster
        return 0
    fi

    log_error "Validation FAILED for: ${VALIDATED_FAILED}"
    for _vs_name in $VALIDATED_FAILED; do
        log_error "--- last log lines from ${_vs_name}:"
        docker logs --tail 5 "$_vs_name" 2>&1 | sed 's/^/    /'
        case "$_vs_name" in
            gendl-*|genworks-*)
                log_error "    (CCL ASLR wedge? check host kernel log for 'bad frame in rt_sigreturn' -- upstream Clozure/ccl#85)"
                ;;
        esac
    done
    log_error "autoheal (if running) will keep retrying; investigate with: docker logs <name>"
    return 1
}

