    _ssw_term="${BASILISK_VOCAB_HAIL_TERM:-rmax}"
    _ssw_gui="${BASILISK_VOCAB_HAIL_GUI:-grmax}"
    printf "%b\n" "  \`${_ssw_term}\`   ${BLUE}-- hail the Captain: terminal emacsclient (attach here)${NC}"
    printf "%b\n" "  \`${_ssw_gui}\`  ${BLUE}-- graphical emacsclient (opens new window)${NC}"
    printf "%b\n" "  \`${_ssw_term} @<instance>\` ${BLUE}-- reach another ship on this box${NC}"
    printf "%b\n" "  ${BLUE}(\`eskew\`/\`egskew\` stay aboard as aliases)${NC}"
