pull_images() {
    if [ -n "${NO_PULL}" ]; then
        log_info "Skipping pull (NO_PULL set; explicit './basilisk pull' or 'up --pull' overrides)"
        return
    fi

    if [ -n "${PULL_ALWAYS}" ]; then
        log_info "Beaming the whole complement aboard fresh (PULL_ALWAYS set)"
        run_compose pull
        return
    fi

    _svc_img_pairs="$(
        run_compose config | awk '
            $1 == "services:" { in_services=1; next }
            in_services && match($0, /^[[:space:]]{2}[A-Za-z0-9_-]+:$/) {
                service=$1; sub(":", "", service); next
            }
            in_services && $1 == "image:" { print service, $2 }
        '
    )"

    _missing=""
    while IFS=" " read -r _svc _img; do
        [ -z "$_svc" ] || [ -z "$_img" ] && continue
        # A hand already onboard warrants no line of his own; only the
        # ones who need the transporter get named below.
        if ! docker image inspect "$_img" > /dev/null 2>&1; then
            _missing="${_missing:+$_missing }$_svc"
        fi
    done << _PAIRS
$_svc_img_pairs
_PAIRS

    if [ -z "$_missing" ]; then
        log_success "All crew already onboard, nobody to be beamed aboard"
        return
    fi

    log_info "Beaming aboard: $_missing"
    # shellcheck disable=SC2086  (word-split intentional: service names)
    run_compose pull $_missing
}

clean_all() {
    log_warning "This will remove containers, networks, and unused images (including pulled ones)"
    printf "Are you sure? (y/N): "
    read -r REPLY
    case "$REPLY" in
        [Yy]*)
            log_info "Cleaning up..."
            run_compose down --rmi all --volumes --remove-orphans
            release_ship
            docker system prune -f
            log_success "Cleanup complete"
            ;;
        *)
            log_info "Cleanup cancelled"
            ;;
    esac
}

show_config() {
    log_info "Showing merged Docker Compose configuration"
    run_compose config
}

# =============================================================================
# SHELL FUNCTION INSTALLATION
#
# Detects the user's login shell and writes to the appropriate RC file(s).
# Supports bash (.bashrc), zsh (.zshrc), and generic POSIX (.profile).
# Also updates .bash_profile / .zprofile if they already exist (macOS).
# =============================================================================
install_shell_functions() {
    _isf_dir="${HOME}/.config/skewed-emacs"
    # A fork's vocabulary may rename the hailing calls (the yard's own
    # words are rmax/grmax).  Renamed calls get their OWN helpers file,
    # so a canon stack and a fork sharing one box do not overwrite each
    # other's -- both files source cleanly side by side, each defining
    # its own call names.
    _isf_term="${BASILISK_VOCAB_HAIL_TERM:-rmax}"
    _isf_gui="${BASILISK_VOCAB_HAIL_GUI:-grmax}"
    if [ "$_isf_term" != "rmax" ] || [ "$_isf_gui" != "grmax" ]; then
        _isf_file="${_isf_dir}/shell-functions-${_isf_term}.sh"
    else
        _isf_file="${_isf_dir}/shell-functions.sh"
    fi
    SHELL_HELPERS_CHANGED=false

    mkdir -p "${_isf_dir}"
    _isf_tmp="${_isf_dir}/shell-functions.sh.tmp.$$"

    # The snippet is pure POSIX sh -- works when sourced from any shell.
    cat > "${_isf_tmp}" << 'SNIPPET'
# Readymax shell helpers - auto-generated by compose-dev
# Works in bash, zsh, sh, or any POSIX-compatible shell.

# Every helper is a `docker exec` into the Captain's container.  A box may
# legitimately be running a hull with no Captain aboard -- a minimal
# roster, or a standalone Cyclops or KBE-server deployment -- and in that
# case docker's own "No such container" says nothing about what is
# actually going on.  Answer in the ship's own terms.
# The container name is the ready room keeper's MINTED name (it changes
# at each relief), so it is read off the standing muster roll in the
# basilisk clone this helper was generated from.  BASILISK_CAPTAIN
# overrides for an exotic rig; with more than one Basilisk on a box,
# container names carry the instance prefix, derived from the instance
# label the same way compose-dev derives it -- name the ship you mean
# with a leading @-arg, or the env var:
#     rmax @alpha my-proj.lisp
#     BASILISK_INSTANCE=alpha rmax my-proj.lisp
_skew_captain() {
    _sc_prefix="${BASILISK_PREFIX:-${BASILISK_INSTANCE:+$BASILISK_INSTANCE-}}"
    _sc_roll="@BASILISK_DIR@/.muster${BASILISK_INSTANCE:+-$BASILISK_INSTANCE}"
    _sc_name="${BASILISK_CAPTAIN:-$(sed -n 's/^BASILISK_CREW_READY_ROOM=//p' "$_sc_roll" 2>/dev/null | head -1)}"
    printf '%s%s' "$_sc_prefix" "${_sc_name:-ready-room}"
}

_skew_captain_aboard() {
    command -v docker >/dev/null 2>&1 || return 1
    [ "$(docker inspect -f '{{.State.Running}}' "$(_skew_captain)" 2>/dev/null)" = "true" ]
}

_skew_no_captain() {
    _snc_name="$(_skew_captain)"
    if ! command -v docker >/dev/null 2>&1; then
        printf '%s: docker not found on this host -- no way to reach the Captain.\n' "$1" >&2
    elif docker inspect "$_snc_name" >/dev/null 2>&1; then
        printf '%s: the Captain is aboard but not on watch (container "%s" is not running).\n' "$1" "$_snc_name" >&2
        printf '  Rouse the Captain:  docker start %s\n' "$_snc_name" >&2
    else
        printf '%s: no Captain aboard this ship (no "%s" container).\n' "$1" "$_snc_name" >&2
        printf '  Bring one aboard:  ./basilisk up\n' >&2
        printf '  Another ship on this box?  %s @<instance>\n' "$1" >&2
    fi
    return 1
}

_rmax_term() {
    _rt_call="$1"; shift
    _skew_captain_aboard || { _skew_no_captain "$_rt_call"; return 1; }
    docker exec -it --detach-keys "ctrl-^" "$(_skew_captain)" emacsclient -t "$@"
}

_rmax_gui() {
    _rg_call="$1"; shift
    _skew_captain_aboard || { _skew_no_captain "$_rg_call"; return 1; }
    if [ -n "$DISPLAY" ] || [ -n "$WAYLAND_DISPLAY" ]; then
        docker exec -i -e DISPLAY="$DISPLAY" -e WAYLAND_DISPLAY="$WAYLAND_DISPLAY" \
            --detach-keys "ctrl-^" "$(_skew_captain)" emacsclient -c "$@" &
    else
        docker exec -it --detach-keys "ctrl-^" "$(_skew_captain)" emacsclient -t "$@"
    fi
}

# rmax [@instance] [emacsclient args...] -- hail the Captain in your
# current terminal.  A leading @-arg names the instance when several
# ships share the box (a filename genuinely starting with @ can hide
# behind ./).  The subshell keeps the per-call choice out of the
# caller's environment, and an explicit @ outranks any ambient
# BASILISK_PREFIX/BASILISK_CAPTAIN override.
rmax() {
    case "$1" in
        @?*) _rmx_i="${1#@}"; shift
             ( BASILISK_INSTANCE="$_rmx_i"; export BASILISK_INSTANCE
               unset BASILISK_PREFIX BASILISK_CAPTAIN
               _rmax_term rmax "$@" ) ;;
        *)   _rmax_term rmax "$@" ;;
    esac
}

# grmax [@instance] [emacsclient args...] -- the Captain receives you in
# a new window (graphical emacsclient; falls back to a terminal
# attach when no display is present).
grmax() {
    case "$1" in
        @?*) _grx_i="${1#@}"; shift
             ( BASILISK_INSTANCE="$_grx_i"; export BASILISK_INSTANCE
               unset BASILISK_PREFIX BASILISK_CAPTAIN
               _rmax_gui grmax "$@" ) ;;
        *)   _rmax_gui grmax "$@" ;;
    esac
}

# The long-serving hailing calls stay aboard as aliases for rmax/grmax.
eskew()  { rmax "$@"; }
egskew() { grmax "$@"; }
SNIPPET

    # The snippet heredoc is quoted (no interpolation at write time), so
    # the clone's own path rides in via a placeholder: the helpers must
    # find THIS clone's muster roll from any shell, anywhere.
    sed "s|@BASILISK_DIR@|${SCRIPT_DIR}|g" "${_isf_tmp}" > "${_isf_tmp}.sub" \
        && mv "${_isf_tmp}.sub" "${_isf_tmp}"

    # The rename itself: shipped code stays verbatim -- it is a
    # generated-file substitution, like the clone path above.  Both
    # calls tokenize before either expands, so the shorter word never
    # bites a piece out of the longer one (grmax contains rmax).
    if [ "$_isf_term" != "rmax" ] || [ "$_isf_gui" != "grmax" ]; then
        sed "s|grmax|@HAIL_GUI@|g; s|rmax|@HAIL_TERM@|g; s|@HAIL_GUI@|${_isf_gui}|g; s|@HAIL_TERM@|${_isf_term}|g" \
            "${_isf_tmp}" > "${_isf_tmp}.sub" \
            && mv "${_isf_tmp}.sub" "${_isf_tmp}"
    fi

    if [ -f "${_isf_file}" ] && cmp -s "${_isf_tmp}" "${_isf_file}"; then
        rm -f "${_isf_tmp}"
        # already current -- a no-change earns no line
    else
        mv "${_isf_tmp}" "${_isf_file}"
        SHELL_HELPERS_CHANGED=true
        log_success "Shell functions written to ${_isf_file}"
    fi

    # Use '.' not 'source' -- POSIX portable
    _isf_source_line=". \"${_isf_file}\""

    # Primary RC based on login shell
    case "${SHELL##*/}" in
        zsh)  _isf_primary="${HOME}/.zshrc" ;;
        bash) _isf_primary="${HOME}/.bashrc" ;;
        ksh)  _isf_primary="${HOME}/.kshrc" ;;
        *)    _isf_primary="${HOME}/.profile" ;;
    esac

    # Belt and suspenders for fresh machines: login and non-login shells
    # read different RC files (.profile vs .bashrc), and a fresh account may
    # have SHELL=/bin/sh.  Ensure both .bashrc and .profile carry the source
    # line; the grep guard below keeps this idempotent.
    touch "$_isf_primary" "${HOME}/.bashrc" "${HOME}/.profile" 2>/dev/null || true

    _isf_wrote=false
    _isf_wrote_files=""
    _isf_seen=""
    # Write to primary, .bashrc, and .profile always; .bash_profile / .zprofile if they exist.
    # The primary is usually one of the fixed entries, so dedupe -- it
    # used to earn .bashrc two identical "already in" lines per raise.
    for _isf_rc in "$_isf_primary" "${HOME}/.bashrc" "${HOME}/.profile" \
                   "${HOME}/.bash_profile" "${HOME}/.zprofile"; do
        [ -f "$_isf_rc" ] || continue
        case " $_isf_seen " in *" $_isf_rc "*) continue ;; esac
        _isf_seen="$_isf_seen $_isf_rc"
        if grep -qF "skewed-emacs/$(basename "$_isf_file")" "$_isf_rc" 2>/dev/null; then
            :  # already rigged -- a no-change earns no line
        else
            printf '\n# Readymax shell helpers\n%s\n' "$_isf_source_line" >> "$_isf_rc"
            log_success "Added skewed-emacs shell helpers to ${_isf_rc}"
            _isf_wrote=true
            _isf_wrote_files="${_isf_wrote_files:+${_isf_wrote_files}, }${_isf_rc}"
            SHELL_HELPERS_CHANGED=true
        fi
    done

    if [ "$_isf_wrote" = "true" ]; then
        log_info "Helpers wired into: ${_isf_wrote_files}"
        log_info "Open a new terminal (or run:  . ${_isf_file}  ) to activate ${BASILISK_VOCAB_HAIL_TERM:-rmax}/${BASILISK_VOCAB_HAIL_GUI:-grmax}"
    fi
}

refresh_emacs_runtime_config() {
    _rerc_cap="$(room_container ready-room)"
    [ -n "$_rerc_cap" ] || { log_warning "no keeper for the ready room; skipping Emacs service refresh"; return 0; }
    _refresh_result="$(docker exec "$_rerc_cap" emacsclient --eval \
        "(progn
            (defvar skewed-runtime-services-refresh-armed nil)
            (defvar skewed-runtime-services-refresh-done nil)
            (defun skewed-runtime-services-refresh ()
              (when (and (require 'services-discovery nil t)
                         (not skewed-runtime-services-refresh-done))
                (setq skewed-runtime-services-refresh-done t)
                (skewed-reload-services)
                (when (and (require 'dashboard nil t)
                           (get-buffer \"*dashboard*\"))
                  (with-current-buffer \"*dashboard*\"
                    (dashboard-refresh-buffer)))
                'ok))
            (unless skewed-runtime-services-refresh-armed
              (setq skewed-runtime-services-refresh-armed t)
              (with-eval-after-load 'services-discovery
                (skewed-runtime-services-refresh))
              (with-eval-after-load 'dashboard
                (skewed-runtime-services-refresh)))
            (or (skewed-runtime-services-refresh) 'deferred))" 2>/dev/null || true)"

    case "$_refresh_result" in
        *ok*)
            log_success "Reloaded generated services in the running Emacs session"
            ;;
        *deferred*)
            log_info "Queued a final Emacs service refresh after startup completes"
            ;;
        "")
            log_info "Skipped immediate Emacs service refresh; the daemon is still initializing"
            ;;
        *)
            log_warning "Emacs service reload hook failed: ${_refresh_result}"
            ;;
    esac
}

