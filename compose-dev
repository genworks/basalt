}

# =============================================================================
# MAIN
# =============================================================================
main() {
    # Variant switches: pick the skewed-emacs image variant for this
    # invocation (same names as docker/build targets).  They set
    # EMACS_IMAGE_VARIANT, which the compose image tag interpolates;
    # a shell-exported value wins over .env.  Works with any command
    # that touches images (up, pull, restart, config, ...).
    _remaining=""
    for _arg in "$@"; do
        case "$_arg" in
            --lite)              EMACS_IMAGE_VARIANT=lite ;;
            --default)           EMACS_IMAGE_VARIANT=default ;;
            --tui|--aituis)      EMACS_IMAGE_VARIANT=tui ;;
            --gui)               EMACS_IMAGE_VARIANT=gui ;;
            --full|--gui-aituis) EMACS_IMAGE_VARIANT=full ;;
            *) _remaining="${_remaining:+$_remaining
}$_arg" ;;
        esac
    done
    # No switch and nothing in the environment: fall back to this
    # clone's host pin, the same file systemd reads as an
    # EnvironmentFile.  Without this the two start paths disagree --
    # `systemctl start basilisk' honours the pin while `./basilisk up'
    # silently takes the compose default, which is `full', so a ship
    # pinned to `lite' flies heavy whenever anyone starts it by hand.
    if [ -f "$SCRIPT_DIR/systemd/host.env" ]; then
        # Every KEY=VALUE in host.env, not just the variant: it is this
        # clone's host pin file, and a production ingress pins its
        # published port there too.  Only fills values that are not
        # already set, so a flag or an inherited variable still wins.
        while IFS='=' read -r _k _v; do
            case "$_k" in ''|\#*) continue ;; esac
            if [ -z "$(eval "echo \${$_k:-}")" ]; then
                export "$_k=$_v"
            fi
        done < "$SCRIPT_DIR/systemd/host.env"
    fi
    if [ -n "${EMACS_IMAGE_VARIANT:-}" ]; then
        export EMACS_IMAGE_VARIANT
        log_info "skewed-emacs image variant: ${EMACS_IMAGE_VARIANT}"
    fi
    # Rebuild positional args minus the variant switches (newline
    # delimiter so service names with spaces would still be wrong, but
    # compose service names cannot contain spaces).
    if [ -n "$_remaining" ]; then
        _old_ifs=$IFS; IFS='
'
        # shellcheck disable=SC2086
        set -- $_remaining
        IFS=$_old_ifs
    else
        set --
    fi

    case "${1:-help}" in
        help|--help|-h) ;;
        *) preflight_checks || exit 1 ;;
    esac

    check_docker_compose

    # Re-export the standing muster roll for EVERY command: compose
    # interpolates container_name from BASILISK_CREW_* on any invocation
    # that might create a container (a kill+recreate during `restart'
    # validation, say), and an unset var would quietly rename the hand
    # to the bare module slug.  `up' refreshes the roll itself via
    # muster_crew; everything else sails on the roll as it stands.
    muster_load

    case "${1:-help}" in
        up)
            shift
            _up_daemon=false
            _up_remaining=""
            for _up_arg in "$@"; do
                case "$_up_arg" in
                    --daemon|-d) _up_daemon=true ;;
                    # The operator's explicit order outranks the
                    # standing one: --pull clears NO_PULL (which
                    # host.env may set on a provisioned ship), or the
                    # documented deploy step `up --pull' would silently
                    # stop pulling on exactly the ships it matters for.
                    --pull)      PULL_ALWAYS=1; NO_PULL="" ;;
                    *)           _up_remaining="${_up_remaining:+$_up_remaining }$_up_arg" ;;
                esac
            done
            # shellcheck disable=SC2086  (word-split intentional: service names)
            start_services $_up_remaining
            _up_rc=$?

            if [ "$_up_daemon" = "false" ]; then
                install_shell_functions
                if [ "$SHELL_HELPERS_CHANGED" = "true" ]; then
                    show_skew_welcome
                    # Close the slipway before handing over: exec
                    # replaces this process with the welcome shell,
                    # which would otherwise inherit fd 9 -- and the
                    # flock with it -- for the life of the operator's
                    # session, blocking every later raise (found live,
                    # 2026-08-24: an eskew attach held the slipway for
                    # 18 minutes).
                    exec 9>&- 2>/dev/null || true
                    exec "${SHELL:-sh}" -i
                fi
            fi
            # Propagate validation failure (systemd oneshot units watch
            # this exit status; the old code always exited 0 under -d).
            [ "$_up_rc" -eq 0 ] || exit "$_up_rc"
            ;;
        down)   stop_services ;;
        restart) shift; restart_services "$@" ;;
        stop)   shift; run_compose stop "$@" ;;
        logs)   shift; show_logs "$@" ;;
        status|ps) show_status ;;
        emacs)  connect_emacs ;;
        # Typing `pull' IS the explicit request, so it too outranks a
        # host.env NO_PULL -- a provisioned ship still takes on stores
        # when told to.
        pull)   NO_PULL=""; pull_images ;;
        clean)  clean_all ;;
        install-shell-functions) install_shell_functions ;;
        init)
            init_env
            ensure_env
            log_success "Environment initialized"
            ;;
        config) show_config ;;
        help|--help|-h) show_help ;;
        *)
            log_error "Unknown command: $1"
            printf "Use '%s help' for usage information\n" "$0"
            exit 1
            ;;
    esac
}

main "$@"
